# Copy this file to .env and fill in your API key.
# Only ONE key is needed. The system auto-detects which backend to use.

# Option 1: Anthropic Claude (recommended - cheap with haiku)
ANTHROPIC_API_KEY=sk-ant-...

# Option 2: OpenAI
# OPENAI_API_KEY=sk-...

# Option 3: Google Gemini (free tier available)
# GEMINI_API_KEY=AIza...

# Optional: override which model is used
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-1.5-flash

# Optional: override embedding model
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

	skos:prefLabel """Sm antibody, immunodiffusion or other method"""@en ;
	skos:notation """SM"""^^xsd:string ;
	skos:definition """Sm antibody: an antibody against a component of ENA. The sm antigen is insensitive to ribonuclease digestion. Sm antibody fulfills a diagnostic criterion for SLE but may also be seen in other diseases."""@en ;

<http://purl.bioontology.org/ontology/AIR/ANTIC> a owl:Class ;
	skos:prefLabel """Circulating anticoagulant, lupus anticoagulant or antiphospholipid antibodies"""@en ;
	skos:notation """ANTIC"""^^xsd:string ;

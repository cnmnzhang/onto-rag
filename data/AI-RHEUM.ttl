 .

<http://purl.bioontology.org/ontology/AIR/KNJK> a owl:Class ;
	skos:prefLabel """Decreased knee jerk on affected side"""@en ;
	skos:notation """KNJK"""^^xsd:string ;
	skos:definition """Knee Jerk: A reflex elicited by tapping with a neurological hammer or the fingers under the patella. The test is best performed when the patient is sitting with legs not touching the floor. Normal is a moderate forward movement of the lower leg."""@en ;
	rdfs:subClassOf <http://purl.bioontology.org/ontology/AIR/U000053> ;
	rdfs:subClassOf <http://purl.bioontology.org/ontology/AIR/MFNEU> ;

<http://purl.bioontology.org/ontology/AIR/PASEX> a owl:Class ;
	skos:prefLabel """Pain with restricted abduction and/or rotation"""@en ;
	skos:notation """PASEX"""^^xsd:string ;
	skos:definition """WHAT: Restriction of the external rotation of the shoulder joint.	WHY:	This maneuver is the single best test for disease of the shoulder joint itself. Elevation and abduction of the shoulder can be performed by moving the scapula with a fixed glenohumeral joint. External rotation cannot be compensated in this way. Restricted external rotation is most prominent in RA and polymyalgia rheumatica.	HOW:	Patient in sitting position, elbow flexed 90 degrees. Rotate forearm outwards. Normal is 80-90 degrees."""@en ;
	rdfs:subClassOf <http://purl.bioontology.org/ontology/AIR/U000097> ;
	rdfs:subClassOf <http://purl.bioontology.org/ontology/AIR/MFART> ;
	rdfs:subClassOf <http://purl.bioontology.org/ontology/AIR/SHOB> ;
	umls:cui """C0221654"""^^xsd:string ;
	umls:tui """T184"""^^xsd:string ;
	umls:hasSTY <http://purl.bioontology.org/ontology/STY/T184> ;
 .


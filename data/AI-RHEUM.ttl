<http://purl.bioontology.org/ontology/AIR/SSB> a owl:Class ;
	skos:prefLabel """SS-B antibody, immunodiffusion or other method"""@en ;
	skos:notation """SSB"""^^xsd:string ;
	skos:definition """SS-B antibody: an antibody to a nucleoprotein that is also called La. It is associated with primary Sjogren's syndrome but can be seen in SLE and other diseases. It has been associated with neonatal lupus and heart block."""@en ;

<http://purl.bioontology.org/ontology/AIR/PERTI> a owl:Class ;
	skos:prefLabel """Periostitis at sites of tendon insertions present"""@en ;
	skos:notation """PERTI"""^^xsd:string ;
	skos:definition """Periostitis at Tendon Insertions: inflammation of the periosteum at tendon insertions, shown on X-rays by irregularity of the bone cortex near the metaphysis and usually new deposition of cortical bone."""@en ;
	rdfs:subClassOf <http://purl.bioontology.org/ontology/AIR/U000087> ;
	rdfs:subClassOf <http://purl.bioontology.org/ontology/AIR/XRAYS> ;
	umls:cui """C0221622"""^^xsd:string ;
	umls:tui """T033"""^^xsd:string ;
	umls:hasSTY <http://purl.bioontology.org/ontology/STY/T033> ;
 .

<http://purl.bioontology.org/ontology/AIR/ACPA> a owl:Class ;
	skos:prefLabel """Anti-cytoplasmatic antibodies"""@en ;
	skos:notation """ACPA"""^^xsd:string ;
	skos:definition """WHAT: Anti-cytoplasmatic antibodies	Antibodies to component of the cytoplasma of granulocytes.	HOW:	Anti-cytoplasmatic antibodies are detected by immunofluorescence with patient serum on granulocytes of donors.	WHY:	They are present in up to 70% of patients with Wegener's disease and are apparently quite specific for this disease. Several investigators were unable to demonstrate them in patients with other systemic diseases or autoimmune diseases.	REFS:	Cohen Tervaert et al. Association between active Wegener's granulomatosis and anti-cytoplasmatic antibodies. Arch Int Med 1989; 149:2461."""@en ;
	rdfs:subClassOf <http://purl.bioontology.org/ontology/AIR/U000065> ;
	rdfs:subClassOf <http://purl.bioontology.org/ontology/AIR/MFLSE> ;
	umls:cui """C0151384"""^^xsd:string ;
	umls:tui """T034"""^^xsd:string ;
	umls:hasSTY <http://purl.bioontology.org/ontology/STY/T034> ;
 .


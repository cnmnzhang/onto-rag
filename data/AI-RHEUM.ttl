 .

<http://purl.bioontology.org/ontology/AIR/PRTUR> a owl:Class ;
	skos:prefLabel """Proteinuria (normal less than 0.5 gm/24 hrs)"""@en ;
	skos:notation """PRTUR"""^^xsd:string ;
	skos:definition """Proteinuria: In adults, the normal 24 hour urinary protein excretion ranges from 40 to 100 mg. Increased protein excretion can be seen in a number of systemic inflammatory processes. Particularly, the vasculitides. Persistent excretion of more than 500 mg in 24 hours satisfies a diagnostic criterion for systemic lupus erythematosus."""@en ;
	rdfs:subClassOf <http://purl.bioontology.org/ontology/AIR/MFLUR> ;
	rdfs:subClassOf <http://purl.bioontology.org/ontology/AIR/U000075> ;

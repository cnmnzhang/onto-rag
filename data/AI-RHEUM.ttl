 .

<http://purl.bioontology.org/ontology/AIR/RANBX> a owl:Class ;
	skos:prefLabel """Skin biopsy, subcutaneous RA nodule"""@en ;
	skos:notation """RANBX"""^^xsd:string ;
	skos:definition """Subcutaneous Rheumatoid Nodule: a subcutaneous nodule which reveals an irregularly shaped central zone of fibrinoid necrosis surrounded by large mononuclear cells. This core is enveloped by an outer zone of granulation tissue containing lymphocytes and plasma cells."""@en ;
	rdfs:subClassOf <http://purl.bioontology.org/ontology/AIR/U000036> ;
	rdfs:subClassOf <http://purl.bioontology.org/ontology/AIR/MFSBX> ;
	rdfs:subClassOf <http://purl.bioontology.org/ontology/AIR/U000035> ;
	umls:cui """C0151184"""^^xsd:string ;
	umls:tui """T033"""^^xsd:string ;
	umls:hasSTY <http://purl.bioontology.org/ontology/STY/T033> ;
 .

<http://purl.bioontology.org/ontology/AIR/WBC> a owl:Class ;
	skos:prefLabel """WBC count (normal 4000-10,800/cu mm)"""@en ;
	skos:notation """WBC"""^^xsd:string ;
	skos:definition """A leukocytosis is a frequent but nonspecific finding in many systemic inflammatory processes. Leukopenia is a characteristic but not universal feature of SLE - a WBC of less than 4,000/mm3 on three or more occasions fulfills a diagnostic criterion. Peripheral eosinophilia is seen with the Churg-Strauss syndrome."""@en ;
	rdfs:subClassOf <http://purl.bioontology.org/ontology/AIR/MFLHE> ;
	rdfs:subClassOf <http://purl.bioontology.org/ontology/AIR/U000064> ;
	umls:cui """C0151373"""^^xsd:string ;
	umls:tui """T033"""^^xsd:string ;
	umls:hasSTY <http://purl.bioontology.org/ontology/STY/T033> ;
 .

<http://purl.bioontology.org/ontology/AIR/ANXIE> a owl:Class ;
	skos:prefLabel """Anxiety"""@en ;
	skos:notation """ANXIE"""^^xsd:string ;

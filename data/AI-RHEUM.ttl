 .

<http://purl.bioontology.org/ontology/AIR/FANAD> a owl:Class ;
	skos:prefLabel """FANA +, diffuse or homogeneous"""@en ;
	skos:notation """FANAD"""^^xsd:string ;
	skos:definition """FANA (Fluorescent Antinuclear Antibody): a test in which standard nuclei are washed with patient serum and then stained with fluorescent labeled antihuman globulin. The pattern of staining may suggest different connective tissue diseases, e.g., 1) diffuse pattern, found in many diseases; 2) rim pattern, more suggestive of SLE; 3) speckled pattern, suggestive of MCTD, SLE and others; nucleolar pattern, suggestive of PSS."""@en ;
	rdfs:subClassOf <http://purl.bioontology.org/ontology/AIR/U000067> ;
	rdfs:subClassOf <http://purl.bioontology.org/ontology/AIR/MFLSE> ;

<http://purl.bioontology.org/ontology/AIR/SACRS> a owl:Class ;
	skos:prefLabel """Sacroiliitis"""@en ;
	skos:notation """SACRS"""^^xsd:string ;
	skos:definition """WHAT: Symmetrical radiological inflammation of the sacroiliac joints.	WHY:	Symmetrical sacroiliitis is a characteristic finding of ankylosing spondylitis, whereas it is less common in Reiter's disease, psoriatic spondylitis, and enteropathic arthritis. In these diseases asymmetric sacroiliitis is not uncommon.	HOW:	Sacroiliitis is diagnosed by radiological findings of the sacroiliac joints. These findings include loss of the normal subchondral plate, indistinctness of the subchondral plate, narrowing or apparent widening of the sacroiliac joint space, subchondral sclerosis on both the iliac and sacral side of the sacroiliac joint, subchondral erosions of the sacroiliac joint and fusion of the sacroiliac joint."""@en ;
	rdfs:subClassOf <http://purl.bioontology.org/ontology/AIR/U000085> ;
	rdfs:subClassOf <http://purl.bioontology.org/ontology/AIR/MFSPI> ;
	umls:cui """C0574960"""^^xsd:string ;
	umls:tui """T047"""^^xsd:string ;
	umls:hasSTY <http://purl.bioontology.org/ontology/STY/T047> ;
 .

<http://purl.bioontology.org/ontology/AIR/KNAR> a owl:Class ;
	skos:prefLabel """Synovial swelling of the knee(s) present"""@en ;
	skos:notation """KNAR"""^^xsd:string ;
	rdfs:subClassOf <http://purl.bioontology.org/ontology/AIR/U000097> ;
	rdfs:subClassOf <http://purl.bioontology.org/ontology/AIR/MFART> ;
	rdfs:subClassOf <http://purl.bioontology.org/ontology/AIR/KNOB> ;
	umls:cui """C0221673"""^^xsd:string ;
	umls:tui """T033"""^^xsd:string ;
	umls:hasSTY <http://purl.bioontology.org/ontology/STY/T033> ;
 .

<http://purl.bioontology.org/ontology/AIR/SACRO> a owl:Class ;
	skos:prefLabel """Sacro-iliac joints: pain elicited by stress-test"""@en ;
	skos:notation """SACRO"""^^xsd:string ;
	skos:definition """WHAT: Pain over the sacroiliac joints, elicited during physical examination while applying stress to the SI-joints.	WHY:	A positive stress test is a weak indication of sacroiliitis or of another disease process involving the SI-joints	HOW:	There are four methods to apply stress to the SI-joints: 1. compression on the side, while the patient is lying on one side; 2. posterior compression on the sacrum; 3. anterior compression on the spinae iliacae; 4. Menell's maneuver: hyperextension of one leg, while the other is in maximal flexion."""@en ;
	rdfs:subClassOf <http://purl.bioontology.org/ontology/AIR/U000097> ;
	rdfs:subClassOf <http://purl.bioontology.org/ontology/AIR/MFSPI> ;
	umls:cui """C0151150"""^^xsd:string ;
	umls:tui """T184"""^^xsd:string ;
	umls:hasSTY <http://purl.bioontology.org/ontology/STY/T184> ;
 .

